<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "GraniteShell" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.svg">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-[#0A0A0A] m-0 text-white min-h-screen flex flex-col justify-between p-4 md:p-6 font-sans overflow-x-hidden">
    
    <%= render "layouts/navbar" %>

    <main class="w-full my-auto relative z-10">
      <%= yield %>
    </main>

    <%= render "layouts/footer" %>

  </body>
</html>