<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
  <head>
    <title><%= content_for(:title) || "GShell — Cognitive Terminal" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    
    <%= favicon_link_tag 'logo.svg', type: 'image/svg+xml' %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-[#08080C] m-0 text-white min-h-screen flex flex-col font-sans selection:bg-brand-emerald/30 selection:text-white">
    
    <%= render "layouts/navbar" %>

    <main class="w-full flex-grow">
      <%= yield %>
    </main>

    <%= render "layouts/footer" %>
    <%= render "components/ui/scroll_to_top" %>

  </body>
</html>