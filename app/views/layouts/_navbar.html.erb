<header class="w-full sticky top-0 z-[100] bg-[#0A0A0A]/90 backdrop-blur-lg border-b border-zinc-800/80">
  
  <div class="w-full px-6 lg:px-12 h-20 grid grid-cols-2 items-center">
    
    <div class="flex justify-start items-center">
      <%= link_to root_path, class: "text-2xl md:text-3xl font-black tracking-widest text-white hover:opacity-80 transition-opacity" do %>
        G<span class="text-brand-emerald">Shell</span>
      <% end %>
    </div>

    <div class="flex justify-end items-center space-x-4 md:space-x-8">
      
      <nav class="flex space-x-4 md:space-x-8 text-sm md:text-[15px] font-sans font-light text-zinc-300">
        <%= link_to 'Home', root_path, class: current_page?(root_path) ? "text-white font-medium" : "hover:text-white transition" %>
        <%= link_to 'Features', features_path, class: current_page?(features_path) ? "text-white font-medium" : "hover:text-white transition" %>
        <%= link_to 'Documentation', docs_path, class: current_page?(docs_path) ? "text-white font-medium" : "hover:text-white transition" %>
      </nav>
      
      <div class="h-6 w-[1px] bg-zinc-700"></div>

      <%= link_to 'Download', download_path, class: "text-brand-amber font-medium hover:text-amber-400 transition" %>
      
    </div>

  </div>
</header>