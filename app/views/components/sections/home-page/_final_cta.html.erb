<section class="w-full max-w-5xl mx-auto my-32 px-4 relative z-10">
  <div class="relative overflow-hidden rounded-2xl border border-brand-emerald/30 bg-zinc-950 px-8 py-16 md:px-16 text-center shadow-[0_0_50px_rgba(16,185,129,0.1)]">
    
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-full bg-[radial-gradient(circle_at_50%_0%,rgba(16,185,129,0.15)_0%,transparent_70%)] pointer-events-none"></div>

    <div class="relative z-10">
      <h2 class="text-3xl md:text-5xl font-black uppercase tracking-tighter text-white mb-6">
        SIAP UNTUK MEREVOLUSI <br> <span class="text-brand-emerald">ALUR KERJA ANDA?</span>
      </h2>
      
      <p class="text-zinc-400 max-w-2xl mx-auto text-sm md:text-base mb-10 font-mono tracking-wide leading-relaxed">
        Gabung dengan era baru kedaulatan AI lokal. Rasakan kendali mutlak tanpa ketergantungan cloud, tanpa biaya API, dan tanpa kompromi privasi.
      </p>

      <div class="flex flex-col sm:flex-row justify-center items-center gap-6">
        <%= link_to download_path, class: "w-full sm:w-auto bg-brand-amber text-zinc-950 font-black px-10 py-4 uppercase tracking-[0.2em] text-sm hover:bg-brand-amber-hover transition-all duration-300 shadow-[0_0_20px_rgba(245,158,11,0.3)]" do %>
          Dapatkan Sekarang
        <% end %>
        
        <a href="#" class="text-white text-xs uppercase tracking-[0.2em] font-bold hover:text-brand-emerald transition group">
          Lihat Dokumentasi <span class="inline-block translate-x-0 group-hover:translate-x-2 transition-transform">→</span>
        </a>
      </div>
    </div>

    <div class="absolute bottom-4 right-4 opacity-10 pointer-events-none">
      <div class="grid grid-cols-4 gap-1">
        <% 16.times do %>
          <div class="w-1 h-1 bg-brand-emerald"></div>
        <% end %>
      </div>
    </div>
  </div>
</section>