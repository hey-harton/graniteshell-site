<section class="w-full max-w-7xl mx-auto my-24 md:my-32 px-4 md:px-6 lg:px-12 relative z-10">
  
  <div class="relative overflow-hidden rounded-sm border border-white/10 bg-[#0C0C12] px-6 py-16 md:py-24 text-center">
    
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[150%] md:w-full h-full bg-[radial-gradient(ellipse_at_top,rgba(16,185,129,0.1)_0%,transparent_60%)] pointer-events-none"></div>

    <div class="relative z-10 flex flex-col items-center">
      
      <h2 class="text-3xl md:text-5xl lg:text-6xl font-light tracking-tight text-white mb-6">
        Siap untuk merevolusi <br class="hidden md:block"> 
        <span class="text-brand-emerald font-normal">alur kerja Anda?</span>
      </h2>
      
      <p class="text-zinc-400 max-w-2xl mx-auto text-sm md:text-[15px] font-sans font-light leading-relaxed mb-10 px-4">
        Gabung dengan era baru kedaulatan AI lokal. Rasakan kendali mutlak tanpa ketergantungan cloud, tanpa biaya API terikat, dan tanpa kompromi privasi sedikit pun.
      </p>

      <div class="flex flex-col sm:flex-row justify-center items-center gap-6 w-full sm:w-auto">
        
        <%= link_to download_path, class: "w-full sm:w-auto flex items-center justify-center bg-brand-amber text-zinc-950 font-medium px-8 py-3 rounded-sm hover:bg-amber-400 transition-colors" do %>
          Dapatkan Sekarang
        <% end %>
        
        <a href="#" class="group flex items-center space-x-2 text-zinc-300 text-sm font-sans font-light hover:text-white transition-colors">
          <span>Lihat Dokumentasi</span>
          <svg class="w-4 h-4 text-brand-emerald transform group-hover:translate-x-1.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
        </a>
        
      </div>
    </div>

    <div class="absolute bottom-6 right-6 opacity-20 pointer-events-none">
      <div class="grid grid-cols-4 gap-1.5">
        <% 16.times do %>
          <div class="w-1 h-1 bg-brand-emerald rounded-full"></div>
        <% end %>
      </div>
    </div>

  </div>
</section>