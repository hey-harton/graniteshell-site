<section class="relative w-full min-h-[90vh] flex flex-col justify-end pt-32 pb-8 overflow-hidden bg-[#08080C]">

  <div class="absolute inset-0 bg-gradient-to-br from-[#08080C] via-[#0B1416] to-[#04110C]"></div>

  <div class="absolute top-1/3 md:top-1/2 left-1/2 md:left-auto md:right-[-5%] lg:right-[5%] -translate-x-1/2 md:translate-x-0 -translate-y-1/2 w-[400px] h-[400px] md:w-[600px] md:h-[600px] pointer-events-none opacity-30 md:opacity-80">
    
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 400" class="w-full h-full animate-[spin_60s_linear_infinite]">
      <defs>
        <radialGradient id="coreGlow" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#10B981" stop-opacity="0.3"/>
          <stop offset="60%" stop-color="#10B981" stop-opacity="0.05"/>
          <stop offset="100%" stop-color="#08080C" stop-opacity="0"/>
        </radialGradient>
        <linearGradient id="lineGrad1" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#10B981" stop-opacity="1"/>
          <stop offset="100%" stop-color="#064E3B" stop-opacity="0.2"/>
        </linearGradient>
        <linearGradient id="lineGrad2" x1="100%" y1="0%" x2="0%" y2="100%">
          <stop offset="0%" stop-color="#F59E0B" stop-opacity="0.8"/>
          <stop offset="100%" stop-color="#10B981" stop-opacity="0.2"/>
        </linearGradient>
      </defs>

      <circle cx="200" cy="200" r="190" fill="url(#coreGlow)" />

      <g fill="none" stroke-width="1.5">
        <ellipse cx="200" cy="200" rx="180" ry="70" stroke="url(#lineGrad1)" transform="rotate(30 200 200)" />
        <ellipse cx="200" cy="200" rx="180" ry="70" stroke="url(#lineGrad1)" transform="rotate(90 200 200)" />
        <ellipse cx="200" cy="200" rx="180" ry="70" stroke="url(#lineGrad1)" transform="rotate(150 200 200)" />
        
        <ellipse cx="200" cy="200" rx="180" ry="40" stroke="url(#lineGrad2)" transform="rotate(-45 200 200)" />
        <ellipse cx="200" cy="200" rx="180" ry="40" stroke="url(#lineGrad2)" transform="rotate(75 200 200)" />
      </g>

      <circle cx="200" cy="200" r="190" fill="none" stroke="#10B981" stroke-width="1" stroke-dasharray="4 8" opacity="0.4" />
      <circle cx="200" cy="200" r="150" fill="none" stroke="#F59E0B" stroke-width="1" stroke-dasharray="2 12" opacity="0.3" />
    </svg>

  </div>

  <div class="w-full max-w-7xl mx-auto px-6 lg:px-12 relative z-10 flex flex-col md:flex-row items-center mb-16 md:mb-28 mt-auto">
    
    <div class="w-full md:w-[60%] flex flex-col justify-center text-center md:text-left items-center md:items-start">
      
      <span class="text-[10px] sm:text-xs md:text-sm font-sans font-medium tracking-widest text-brand-emerald mb-4 uppercase drop-shadow-md">
        Generasi Baru PowerShell
      </span>
      
      <h1 class="text-4xl sm:text-5xl md:text-7xl lg:text-[5.5rem] font-light tracking-tight text-white mb-6 leading-[1.1] md:leading-[1.1]">
        Cognitive <br class="hidden md:block"/> Terminals
      </h1>
      
      <%= link_to features_path, class: "group flex items-center space-x-2 md:space-x-3 text-zinc-300 text-sm md:text-lg font-light hover:text-white transition-colors w-fit text-left" do %>
        <span>Eksplorasi terminal yang bisa melihat, berpikir, & bertindak</span>
        <svg class="w-4 h-4 md:w-5 md:h-5 text-brand-emerald transform group-hover:translate-x-2 transition-transform flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
      <% end %>

    </div>
  </div>

</section>