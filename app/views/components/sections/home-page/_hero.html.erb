<style>
  @keyframes float-slow {
    0%, 100% { transform: translateY(0px) rotate(12deg); }
    50% { transform: translateY(-15px) rotate(15deg); }
  }
  @keyframes float-reverse {
    0%, 100% { transform: translateY(0px) rotate(-45deg); }
    50% { transform: translateY(18px) rotate(-40deg); }
  }
  @keyframes scanline {
    0% { transform: translateY(-100%); }
    100% { transform: translateY(100%); }
  }
  .animate-float-1 { animation: float-slow 8s ease-in-out infinite; }
  .animate-float-2 { animation: float-reverse 11s ease-in-out infinite; }
  .animate-float-3 { animation: float-slow 6s ease-in-out infinite alternate; }
</style>

<div class="absolute inset-0 z-0 pointer-events-none overflow-hidden">
  
  <div class="absolute inset-0 opacity-[0.08] bg-[linear-gradient(to_right,#10B981_1px,transparent_1px),linear-gradient(to_bottom,#10B981_1px,transparent_1px)] bg-[size:4rem_4rem]"></div>
  
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-brand-emerald/15 rounded-full blur-[120px]"></div>

  <div class="absolute inset-x-0 h-[2px] bg-gradient-to-r from-transparent via-brand-emerald/40 to-transparent opacity-80" style="animation: scanline 6s linear infinite;"></div>

  <div class="absolute top-1/4 left-8 md:left-24 w-28 h-28 bg-zinc-900/70 border border-brand-emerald/40 blur-[0.5px] animate-float-1 rounded-sm shadow-[0_0_25px_rgba(16,185,129,0.15)]"></div>
  <div class="absolute top-1/3 right-12 md:right-32 w-36 h-36 bg-zinc-800/40 border border-brand-emerald/30 blur-[1px] animate-float-2 rounded-sm"></div>
  <div class="absolute bottom-24 left-1/3 w-16 h-16 bg-zinc-900/80 border border-brand-emerald/50 animate-float-3 rotate-45 rounded-sm shadow-[0_0_15px_rgba(16,185,129,0.1)]"></div>

  <div class="absolute left-6 top-1/2 -translate-y-1/2 hidden xl:flex flex-col space-y-2 text-[10px] font-mono text-zinc-500 tracking-widest uppercase [writing-mode:vertical-lr]">
    <span>STATUS_SISTEM: AKTIF</span>
    <span class="text-brand-emerald/80 font-bold">NODE_INTI: 0x7F9B</span>
  </div>
  
  <div class="absolute right-6 top-1/2 -translate-y-1/2 hidden xl:flex flex-col space-y-2 text-[10px] font-mono text-zinc-500 tracking-widest uppercase [writing-mode:vertical-lr]">
    <span>LATENSI: 0.02ms</span>
    <span class="text-brand-amber/80 font-bold">MODUL: WIN_PWS_NATIVE</span>
  </div>

</div>

<div class="relative z-10 flex flex-col items-center text-center my-auto py-12">
  
  <span class="text-[10px] md:text-xs font-mono tracking-[0.3em] uppercase text-brand-emerald bg-brand-emerald/5 px-4 py-1.5 rounded-sm border border-brand-emerald/30 mb-6 shadow-[0_0_15px_rgba(16,185,129,0.15)] backdrop-blur-sm">
    RILIS BETA v1.0 • GSHELL
  </span>
  
  <h1 class="text-6xl md:text-8xl font-black tracking-tighter uppercase mb-6 drop-shadow-[0_0_40px_rgba(16,185,129,0.3)]">
     L'INTERFACE
  </h1>
  
  <p class="text-zinc-300 max-w-lg text-xs md:text-sm tracking-wide mb-10 font-mono px-4 leading-relaxed">
    Bebaskan kemampuan murni IBM Granite LLM langsung di dalam lingkungan terminal Windows Anda. Cepat, mandiri, dan terintegrasi secara mendalam.
  </p>

  <%= link_to download_path, class: "relative group overflow-hidden border border-brand-amber px-8 py-4 bg-zinc-950/80 transition-all duration-300 hover:shadow-[0_0_35px_rgba(245,158,11,0.4)] rounded-sm" do %>
    <span class="relative z-10 text-xs md:text-sm font-bold tracking-[0.2em] uppercase text-brand-amber group-hover:text-zinc-950 transition duration-300">
      + INISIALISASI MODUL
    </span>
    <div class="absolute inset-0 bg-brand-amber translate-y-full group-hover:translate-y-0 transition-transform duration-300 ease-out z-0"></div>
  <% end %>

</div>

<div class="relative z-10 flex flex-col items-center mt-12 animate-pulse">
  <span class="text-[9px] font-mono tracking-[0.4em] uppercase text-zinc-500 mb-2">
    Gulir untuk melihat fitur
  </span>
  <div class="w-[1px] h-12 bg-gradient-to-b from-zinc-500 to-transparent"></div>
</div>